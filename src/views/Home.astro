---
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import PostRows from '../components/PostRows.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { siteFor } from '../site';
import { getLang, localize, t, term } from '../i18n';
import { papers, categories, slug, byDate } from '../data/research';
import { getPosts } from '../lib/posts';
import { sortedNews, newsDate } from '../data/news';

const lang = getLang(Astro.url);
const site = siteFor(lang);
const text = t(lang);

const selected = categories
  .map((category) => {
    const types = category.sections.map((section) => section.type);
    return {
      heading: category.heading,
      papers: papers
        .filter((paper) => paper.selected && types.includes(paper.type))
        .sort(byDate),
    };
  })
  .filter((group) => group.papers.length > 0);
const recent = (await getPosts(lang)).slice(0, 3);
const news = sortedNews();
---

<Base wide>
  <div class="home">
    <ProfileCard />

    <div class="home-main">
      <section class="intro">
        <h2 class="label">{text.about}</h2>
        {site.bio.map((paragraph) => <p set:html={paragraph} />)}

        {
          site.interests.length > 0 && (
            <p class="muted small">{text.interests}{lang === 'zh' ? '：' : ': '}{site.interests.join(lang === 'zh' ? '、' : ', ')}</p>
          )
        }
      </section>

      {
        news.length > 0 && (
          <section>
            <h2 class="label">{text.news}</h2>
            <ul class="news-list">
              {news.map((item) => {
                const { month, year } = newsDate(item.date, lang);
                return (
                  <li>
                    <time class="news-date" datetime={item.date}>
                      {lang === 'zh' ? `${year}${month}` : `${month} ${year}`}
                    </time>
                    <div class="news-body">
                      <span set:html={(lang === 'zh' && item.zh) || item.text} />
                      {item.links?.map((link) => (
                        <a class="news-link" href={localize(link.href, lang)}>
                          {term(link.label, lang)}
                        </a>
                      ))}
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        selected.length > 0 && (
          <section class="home-papers">
            {selected.map((group) => (
              <Fragment>
                <h2 class="label">
                  <a href={localize(`/research/#${slug(group.heading)}`, lang)}>{term(group.heading, lang)}</a>
                </h2>
                <ul class="research-cards card-scroll" aria-label={text.selected(term(group.heading, lang))}>
                  {group.papers.map((paper) => (
                    <ResearchCard paper={paper} />
                  ))}
                </ul>
              </Fragment>
            ))}
          </section>
        )
      }

      {
        recent.length > 0 && (
          <section>
            <h2 class="label">
              <a href={localize('/blog/', lang)}>{text.recentWriting}</a>
            </h2>
            <PostRows posts={recent} />
          </section>
        )
      }
    </div>
  </div>
</Base>
