---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import TagFilter from '../components/TagFilter.astro';
import { allTags, getPosts, type Post } from '../lib/posts';
import { getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const text = t(lang);
const posts = await getPosts(lang);
// Most-used tags first.
const tags = allTags(posts)
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
  .map((entry) => entry.tag);

// Group posts by year, newest year first.
const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<Base title={text.blogTitle} description={text.blogDescription}>
  <h1>{text.blogTitle}</h1>
  <p class="muted">{text.blogIntro}</p>

  <TagFilter tags={tags} empty={text.blogEmpty} />

  {posts.length === 0 && <p>{text.noPosts}</p>}

  {
    years.map(([year, yearPosts]) => (
      <section class="research-group filter-group">
        <h2 id={String(year)}>{year}</h2>
        <ul class="research-cards">
          {yearPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      </section>
    ))
  }
</Base>
