---
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import PostRows from '../components/PostRows.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { site } from '../site';
import { papers, categories, slug, byDate } from '../data/research';
import { getPosts } from '../lib/posts';
import { sortedNews, newsDate } from '../data/news';

const selected = categories
  .map((category) => {
    const types = category.sections.map((section) => section.type);
    return {
      heading: category.heading,
      papers: papers
        .filter((paper) => paper.selected && types.includes(paper.type))
        .sort(byDate),
    };
  })
  .filter((group) => group.papers.length > 0);
const recent = (await getPosts()).slice(0, 3);
const news = sortedNews();
---

<Base wide>
  <div class="home">
    <ProfileCard />

    <div class="home-main">
      <section class="intro">
        <h2 class="label">About</h2>
        {site.bio.map((paragraph) => <p set:html={paragraph} />)}

        {
          site.interests.length > 0 && (
            <p class="muted small">Interests: {site.interests.join(', ')}</p>
          )
        }
      </section>

      {
        news.length > 0 && (
          <section>
            <h2 class="label">News</h2>
            <ul class="news-list">
              {news.map((item) => {
                const { month, year } = newsDate(item.date);
                return (
                  <li>
                    <time class="news-date" datetime={item.date}>
                      {month} {year}
                    </time>
                    <div class="news-body">
                      <span set:html={item.text} />
                      {item.links?.map((link) => (
                        <a class="news-link" href={link.href}>
                          {link.label}
                        </a>
                      ))}
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        selected.length > 0 && (
          <section class="home-papers">
            {selected.map((group) => (
              <Fragment>
                <h2 class="label">
                  <a href={`/research/#${slug(group.heading)}`}>{group.heading}</a>
                </h2>
                <ul class="research-cards card-scroll" aria-label={`Selected ${group.heading.toLowerCase()}`}>
                  {group.papers.map((paper) => (
                    <ResearchCard paper={paper} />
                  ))}
                </ul>
              </Fragment>
            ))}
          </section>
        )
      }

      {
        recent.length > 0 && (
          <section>
            <h2 class="label">
              <a href="/blog/">Recent writing</a>
            </h2>
            <PostRows posts={recent} />
          </section>
        )
      }
    </div>
  </div>
</Base>
