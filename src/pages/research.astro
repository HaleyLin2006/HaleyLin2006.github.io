---
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import TagFilter from '../components/TagFilter.astro';
import { papers, categories, slug, byDate } from '../data/research';

const groups = categories
  .map((category) => ({
    heading: category.heading,
    id: slug(category.heading),
    sectionHeadings: category.sectionHeadings !== false,
    sections: category.sections
      .map((section) => ({
        heading: section.heading,
        papers: papers.filter((paper) => paper.type === section.type).sort(byDate),
      }))
      .filter((section) => section.papers.length > 0),
  }))
  .filter((group) => group.sections.length > 0);

// Every tag used on the page, most common first.
const counts = new Map<string, number>();
for (const paper of papers) {
  for (const tag of paper.tags ?? []) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const allTags = [...counts.keys()].sort((a, b) => counts.get(b)! - counts.get(a)! || a.localeCompare(b));
---

<Base title="Research" description="Papers, thesis and other research projects.">
  <h1>Research</h1>
  <p class="muted">
    I'm still figuring out my interest. But here's what I've got so far.
  </p>

  <TagFilter tags={allTags} empty="No papers have all of the selected tags." />

  {
    groups.map((group) => (
      <section class="research-group filter-group">
        <h2 id={group.id}>{group.heading}</h2>
        {group.sections.map((section) => (
          <section class="research-section filter-group">
            {group.sectionHeadings && <h3 class="label">{section.heading}</h3>}
            <ul class="research-cards">
              {section.papers.map((paper) => (
                <ResearchCard paper={paper} />
              ))}
            </ul>
          </section>
        ))}
      </section>
    ))
  }

</Base>
