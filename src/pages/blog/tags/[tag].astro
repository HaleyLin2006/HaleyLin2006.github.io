---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { allTags, getPosts, tagSlug, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allTags(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.some((t) => tagSlug(t) === slug)),
    },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<Base title={`Posts tagged “${tag}”`} description={`Blog posts tagged ${tag}.`}>
  <h1>Posts tagged “{tag}”</h1>
  <ul class="research-cards tag-page-cards">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
  <p class="more"><a href="/blog/">← All posts</a></p>
</Base>
