---
// One blog post as a card, styled like the research cards. The whole card
// links to the post: title, then date | reading time | tags, then the description.
import { tagColor } from '../data/research';
import { formatDate, readingLabel, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;
---

<li class="filter-item" data-tags={tags.join('|')}>
  <a class="research-card post-card" href={`/blog/${post.id}/`}>
    <div class="card-head">
      <h3 class="card-title">{title}</h3>
      <div class="card-info">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{readingLabel(post)}</span>
        {
          tags.length > 0 && (
            <span class="card-tags">
              {tags.map((tag) => (
                <span class={`tag tag-${tagColor(tag)}`}>{tag}</span>
              ))}
            </span>
          )
        }
      </div>
      {description && <p class="card-description">{description}</p>}
      <span class="card-chevron" aria-hidden="true" />
    </div>
  </a>
</li>
