---
// One blog post as a card, styled like the research cards. The whole card
// links to the post: title, then date | reading time | tags, then the description.
import { tagColor } from '../data/research';
import { formatDate, isChinese, readingTime, type Post } from '../lib/posts';
import { getLang, htmlLang, localize, t, term } from '../i18n';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;
const lang = getLang(Astro.url);
const text = t(lang);
// An untranslated post keeps its own language (e.g. a Chinese post on the English site).
const postLang = isChinese(title) ? htmlLang.zh : htmlLang.en;
---

<li class="filter-item" data-tags={tags.join('|')}>
  <a class="research-card post-card" href={localize(`/blog/${post.id}/`, lang)} lang={postLang === htmlLang[lang] ? undefined : postLang}>
    <div class="card-head">
      <h3 class="card-title">{title}</h3>
      <div class="card-info">
        <time datetime={date.toISOString()}>{formatDate(date, true, lang)}</time>
        <span>{text.minRead(readingTime(post.body))}</span>
        {
          tags.length > 0 && (
            <span class="card-tags">
              {tags.map((tag) => (
                <span class={`tag tag-${tagColor(tag)}`} lang={htmlLang[lang]}>{term(tag, lang)}</span>
              ))}
            </span>
          )
        }
      </div>
      {description && <p class="card-description">{description}</p>}
      <span class="card-chevron" aria-hidden="true" />
    </div>
  </a>
</li>
