  email:
    'M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v.379l-10 6.25-10-6.25V5.5Zm0 2.735V18.5A1.5 1.5 0 0 0 3.5 20h17a1.5 1.5 0 0 0 1.5-1.5V8.235l-9.47 5.919a1 1 0 0 1-1.06 0L2 8.235Z',
};

const pin =
  'M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z';

// "Haley (Yu-Heng) Lin" → light "Haley (Yu-Heng)" + bold "Lin"
const parts = site.name.trim().split(/\s+/);
const lastName = parts.pop();
const givenNames = parts.join(' ');

const links = [
  { label: 'CV', href: site.cvPdf || '/cv/', icon: 'cv' },
  ...site.links,
  { label: `Email: ${site.email}`, href: `mailto:${site.email}`, icon: 'email' },
];
---

<aside class="profile">
  {
    site.photo ? (
      <img class="profile-photo" src={site.photo} alt={`Photo of ${site.name}`} />
    ) : (
      <div class="profile-photo is-placeholder" role="img" aria-label="Photo placeholder">
        <svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true">
          <circle cx="12" cy="8.5" r="4" fill="currentColor" />
          <path d="M4 21c0-4.4 3.6-7.5 8-7.5s8 3.1 8 7.5z" fill="currentColor" />
        </svg>
        <span>Your photo here</span>
      </div>
    )
  }

  <h1 class="profile-name">
    {givenNames && <span class="given">{givenNames} </span>}<strong>{lastName}</strong>
  </h1>
  {site.nameAlt && <p class="profile-alt">{site.nameAlt}</p>}
  <p class="profile-role">{site.role}<br />{site.affiliation}</p>

  <ul class="profile-links">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-label={link.label}
            title={link.label}
            rel={link.icon === 'cv' || link.icon === 'email' ? undefined : 'me'}
          >
            {link.icon === 'cv' ? (
              <span class="cv-mark">CV</span>
            ) : (
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d={icons[link.icon]} fill="currentColor" />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>

  {
    site.location && (
      <p class="profile-location">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path d={pin} fill="currentColor" fill-rule="evenodd" />
        </svg>
        {site.location}
      </p>
    )
  }

  {site.quote && <blockquote class="profile-quote">{site.quote}</blockquote>}
</aside>
