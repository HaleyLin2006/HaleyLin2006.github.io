---
// One paper as a card: title, authors, supervisors, then a line with
// date | venue | tags. Clicking the card opens the abstract and links.
import 'katex/dist/katex.min.css';
import { tagColor, type Paper } from '../data/research';
import { latexToHtml } from '../lib/latex';
import { getLang, localDate, t, term } from '../i18n';

interface Props {
  paper: Paper;
}

const { paper } = Astro.props;
const lang = getLang(Astro.url);
const text = t(lang);
const tags = paper.tags ?? [];
const venue = (lang === 'zh' && paper.venueZh) || paper.venue;
const abstract = (lang === 'zh' && paper.abstractZh) || paper.abstract;
const hasDetails = Boolean(paper.abstract) || (paper.links?.length ?? 0) > 0;
const Wrapper = hasDetails ? 'details' : 'div';
const Head = hasDetails ? 'summary' : 'div';
---

<li class="filter-item" data-tags={tags.join('|')}>
  <Wrapper class="research-card">
    <Head class="card-head">
      <h3 class="card-title">{paper.title}</h3>
      <p class="card-authors">{paper.authors.join(', ')}</p>
      {
        paper.supervisors && paper.supervisors.length > 0 && (
          <p class="card-supervisors">
            <em>{text.supervisedBy}{lang === 'zh' ? '' : ' '}{paper.supervisors.join(lang === 'zh' ? '、' : ', ')}</em>
          </p>
        )
      }
      <div class="card-info">
        <span>{localDate(paper.date, lang)}</span>
        {venue && <span class="card-venue">{venue}</span>}
        {
          tags.length > 0 && (
            <span class="card-tags">
              {tags.map((tag) => (
                <span class={`tag tag-${tagColor(tag)}`}>{term(tag, lang)}</span>
              ))}
            </span>
          )
        }
      </div>
      {hasDetails && <span class="card-chevron" aria-hidden="true" />}
    </Head>

    {
      hasDetails && (
        <div class="card-details">
          {abstract && <p class="card-abstract" set:html={latexToHtml(abstract)} />}
          {paper.links && paper.links.length > 0 && (
            <ul class="card-links">
              {paper.links.map((link) => (
                <li>
                  <a class="btn-ghost" href={link.href}>
                    {term(link.label, lang)}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </Wrapper>
</li>
